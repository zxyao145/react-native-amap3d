{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "react-native-amap3d": ["lib/src"]
    }
  },
  "include": ["lib/src/**/*.ts", "lib/src/**/*.tsx", "example-app/**/*.ts", "example-app/**/*.tsx"],
  "exclude": ["node_modules", "lib/android", "lib/ios"]
}
